# Copy to .env.local for local development. In Vercel, add the same names
# under Project → Settings → Environment Variables.

# Supabase → Project Settings → API Keys (safe to expose: keep NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Push notifications — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-only secrets for the reminders job (mark as Sensitive in Vercel)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
CRON_SECRET=any-long-random-string
